APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-random-local-secret-at-least-32-bytes
JWT_SECRET_KEY=replace-with-a-different-random-local-secret-32-bytes
JWT_EXPIRES_MINUTES=30
MONGO_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/edubridge?retryWrites=true&w=majority&appName=EduBridgeAI
TEST_MONGO_URI=
CORS_ORIGINS=http://localhost:5173
BKT_P0=0.30
BKT_T=0.10
BKT_G=0.20
BKT_S=0.10
PROMOTE_M=0.85
PROMOTE_L=0.70
REGRESS_M=0.40
STAGE_STREAK=3
VITE_API_URL=http://localhost:5000/api
